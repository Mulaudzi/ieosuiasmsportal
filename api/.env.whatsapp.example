# Copy these keys into the private API environment when the Meta app is ready.
# This file is an example, not automatically loaded. Never use VITE_* for tokens.
WHATSAPP_SEND_ENABLED=false
# Separately enabled after callback deployment, inbox migration and signature tests.
WHATSAPP_WEBHOOK_ENABLED=false
# Use the version shown in your Meta API Setup request, e.g. vXX.0. No assumed default.
WHATSAPP_META_GRAPH_VERSION=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_WABA_ID=
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_APP_SECRET=
# Choose your own random verification token; it is different from the access token.
WHATSAPP_META_VERIFY_TOKEN=

# Customer-owned WhatsApp signup; independent from outgoing sending and owner's token.
# Enable only after migration 026, private key/config setup and live Meta redirect testing.
WHATSAPP_CONNECT_ENABLED=false
WHATSAPP_CONNECT_APP_ID=
WHATSAPP_CONNECT_CONFIG_ID=
# Existing WhatsApp Business app onboarding; leave blank for the standard flow.
WHATSAPP_CONNECT_FEATURE_TYPE=
# Use for an administrator pilot before customer signup is verified.
WHATSAPP_CONNECT_ADMIN_PILOT_ONLY=true
WHATSAPP_CONNECT_REDIRECT_URI=https://sms.ieosuia.com/api/whatsapp-meta-oauth.php
# Dedicated random 32-byte key, encoded as base64; generate into private storage only.
# Retain securely for backups/recovery. Never use an app secret or VITE_* variable here.
WHATSAPP_CONNECT_TOKEN_KEY=
