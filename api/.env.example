APP_NAME=IEOSUIA SMS Portal
APP_ENV=development
APP_URL=http://localhost:8080/api
APP_DEBUG=false
FRONTEND_URL=http://localhost:8080
AUTH_ISSUER=https://auth.ieosuia.com
AUTH_CLIENT_ID=sms-web
AUTH_REDIRECT_URI=https://sms.ieosuia.com/api/auth/ieosuia/callback
JWT_SECRET=
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_SETUP_KEY=
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
SMS_GATEWAY=mock
# External server-to-server access stays closed until migration 027, its
# prerequisites and the scoped API/UI release have been verified explicitly.
SMS_INTEGRATION_API_ENABLED=false
SMS_DEFAULT_SENDER=IEOSUIA
SMS_PRICE_PER_SEGMENT=0.35
SMS_MAX_SEGMENTS_PER_MESSAGE=6
SMS_MAX_RECIPIENTS_PER_CAMPAIGN=10000
SMS_MAX_DAILY_SEGMENTS=50000
# A cron cycle reserves ~17s to drain network requests safely. These are submission
# ceilings, not sustained throughput, handset-delivery guarantees or customer SLAs.
SMS_PROVIDER_RATE_PER_SECOND=80
SMS_WORKER_BATCH_SIZE=100
# Independent recipient requests in flight; 1 restores sequential dispatch, maximum 40.
# Keep one lock-owning worker. Raising concurrency needs controlled load acceptance.
SMS_WORKER_CONCURRENCY=40
SMS_WORKER_HEALTH_MAX_AGE_SECONDS=120
SMS_SCHEDULER_HEALTH_MAX_AGE_SECONDS=180
SMS_DLR_POLLER_HEALTH_MAX_AGE_SECONDS=300
SMS_MAX_ATTEMPTS=3
SMS_LEASE_SECONDS=300
SMS_DLR_POLL_BATCH_SIZE=100
# Independent status-only lookup batch; cron runs every minute with bounded backoff.
SMS_STATUS_SYNC_ENABLED=true
SMS_STATUS_SYNC_BATCH_SIZE=10
OPERATIONAL_LOG_RETENTION_DAYS=90
SMS_FINAL_FAILURE_REFUND=false
WEBHOOK_BASE_URL=
LOGICSMS_API_URL=https://www.logicsms.co.za/postmsg2.aspx
LOGICSMS_QUERY_URL=https://www.logicsms.co.za/querysms.aspx
LOGICSMS_CREDITS_URL=https://www.logicsms.co.za/querycredits.aspx
LOGICSMS_LOW_CREDIT_THRESHOLD=100
LOGICSMS_USERNAME=
LOGICSMS_PASSWORD=
LOGICSMS_CA_BUNDLE=
LOGICSMS_WEBHOOK_SECRET=
DLR_WEBHOOK_SECRET=
PAYOS_BASE_URL=https://payos.ieosuia.com
PAYOS_CREATE_URL=
PAYOS_TENANT_IDENTIFIER=ieosuia-sms-portal
PAYOS_PUBLIC_KEY=
PAYOS_API_SECRET=
PAYOS_CALLBACK_SECRET=
PAYOS_RETURN_URL=
PAYOS_CANCEL_URL=
PAYOS_CA_BUNDLE=
EFT_BANK_NAME=
EFT_ACCOUNT_NAME=
EFT_ACCOUNT_NUMBER=
EFT_BRANCH_CODE=
# Direct transfers default to the IEOSUIA company account in config/bank-transfer.json.
# Set false to hide direct transfers. Legacy EFT_* values are ignored unless explicitly enabled.
SMS_BANK_TRANSFER_ENABLED=true
SMS_BANK_TRANSFER_USE_ENV=false
SMTP_HOST=
SMTP_PORT=587
SMTP_TIMEOUT=20
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=IEOSUIA SMS Portal
PAYMENT_EMAIL_BATCH_SIZE=25
UPLOAD_MAX_BYTES=5242880
LOG_PATH=
APP_TIMEZONE=Africa/Johannesburg
# Centrally managed administrators: enable only after migration 007 and app connector acceptance.
# Use a dedicated confidential inspection client for the SMS application, not a browser client.
AUTH_CENTRAL_ADMIN_ENABLED=false
AUTH_ADMIN_CLIENT_ID=
AUTH_ADMIN_CLIENT_SECRET=

# Consent-based email campaigns. Keep BOTH switches off until independent release acceptance.
# Never point the campaign transport at shared cPanel hosting without written permission.
EMAIL_CAMPAIGNS_ENABLED=false
EMAIL_CAMPAIGNS_SEND_ENABLED=false
EMAIL_PROVIDER_APPROVED=false
EMAIL_PROVIDER_APPROVAL_REFERENCE=
EMAIL_DOMAIN_AUTH_VERIFIED=false
EMAIL_DOMAIN_AUTH_REFERENCE=
EMAIL_CAMPAIGN_FEEDBACK_VERIFIED=false
EMAIL_CAMPAIGN_WEBHOOK_SECRET=
EMAIL_CAMPAIGN_WEBHOOK_PREVIOUS_SECRET=
EMAIL_CAMPAIGN_SMTP_HOST=
EMAIL_CAMPAIGN_SMTP_PORT=465
EMAIL_CAMPAIGN_SMTP_ENCRYPTION=ssl
EMAIL_CAMPAIGN_SMTP_USER=
EMAIL_CAMPAIGN_SMTP_PASS=
EMAIL_CAMPAIGN_FROM=
# Absolute API base, e.g. https://sms.ieosuia.com/api (no trailing /email)
EMAIL_CAMPAIGN_PUBLIC_URL=
EMAIL_CAMPAIGN_ABUSE_EMAIL=sms@ieosuia.com
# Explicit rolling-hour / rolling-24h limits; 0 blocks sending. All attempts count.
EMAIL_CAMPAIGN_HOURLY_LIMIT=0
EMAIL_CAMPAIGN_DAILY_LIMIT=0
EMAIL_CAMPAIGN_MAX_RECIPIENTS=1000
EMAIL_CAMPAIGN_BATCH_SIZE=10

# Dedicated SES campaign transport only. No system SMTP or operator AWS key reuse.
EMAIL_CAMPAIGN_PROVIDER=smtp
EMAIL_SES_REGION=eu-north-1
EMAIL_SES_ACCOUNT_ID=
EMAIL_SES_IDENTITY=campaigns.ieosuia.com
EMAIL_SES_CONFIGURATION_SET=ieosuia-portal-campaigns
EMAIL_SES_SNS_TOPIC_ARN=
EMAIL_SES_FEEDBACK_ENABLED=false
EMAIL_SES_AUTO_CONFIRM_SUBSCRIPTIONS=false
EMAIL_SES_QUOTA_FILE=
EMAIL_SES_QUOTA_HMAC_KEY=
EMAIL_SES_QUOTA_MAX_AGE=300
EMAIL_SES_QUOTA_RESERVE=10
EMAIL_SES_SEND_RATE=1

# Admin and customer transfers of existing, unreserved SMS credits. Migration 021 and
# InnoDB wallet/security prerequisites are required. Admin approval uses the finance
# master password; customer self-transfers use a code via existing system SMTP.
CREDIT_TRANSFERS_ENABLED=false
# Apply scoped migration 024 first; sender receipts only for newly committed transfers.
CREDIT_TRANSFER_RECEIPTS_ENABLED=false
# Apply scoped migration 025 (requires existing 015/017) before enabling standalone rand credits.
CASH_BALANCE_ADJUSTMENTS_ENABLED=false

# Optional app-local email sign-in codes; system transactional SMTP, not SES campaigns.
# Apply only migration 023 after review. Configure a dedicated random secret privately.
# Once enrolled, enforcement never depends on the enrollment switch being on.
SMS_LOGIN_ENROLLMENT_ENABLED=false
# Optional comma-separated local user IDs for pilot enrollment; empty permits all.
SMS_LOGIN_ENROLLMENT_PILOT_USERS=
SMS_LOGIN_CODE_SECRET=
# Set true with activation: missing security tables must then fail closed.
SMS_LOGIN_SECURITY_REQUIRED=false
# Disabled until Central Auth publishes the separately reviewed signed event contract.
CENTRAL_SECURITY_EVENTS_ENABLED=false
CENTRAL_SECURITY_EVENTS_SECRET=

# Isolated AWS campaign service; separate from transactional SMTP and the old local worker.
# Apply only scoped migration 029 after acceptance. Keep both sending gates off until launch.
EMAIL_AWS_ENABLED=false
EMAIL_AWS_SEND_ENABLED=false
EMAIL_AWS_ACCOUNTING_ENABLED=false
EMAIL_AWS_PILOT_EMAILS=
EMAIL_AWS_API_URL=
EMAIL_AWS_PORTAL_KEY=
EMAIL_AWS_ACCOUNTING_KEY=
EMAIL_AWS_ACCOUNTING_PREVIOUS_KEY=
