# IEOSUIA SMS Portal - Environment Configuration
# Copy this to .env and update values

APP_NAME="IEOSUIA SMS Portal"
APP_ENV=production
APP_KEY=base64:YOUR_APP_KEY_HERE
APP_DEBUG=false
APP_URL=https://sms.ieosuia.com/api
FRONTEND_URL=https://sms.ieosuia.com

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smsportal
DB_USERNAME=smsportal_user
DB_PASSWORD=your_secure_password

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Queue (Redis recommended for production)
QUEUE_CONNECTION=database
# QUEUE_CONNECTION=redis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# Mail (for email campaigns)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@ieosuia.com"
MAIL_FROM_NAME="${APP_NAME}"

# SMS Gateway - LogicSMS
LOGICSMS_API_URL=https://www.aborinteractive.co.za/AboriGateway/rest/sms
LOGICSMS_USERNAME=your_username
LOGICSMS_PASSWORD=your_password
LOGICSMS_DEFAULT_SENDER=IEOSUIA

# SMS Gateway - BulkSMS (backup)
BULKSMS_API_URL=https://api.bulksms.com/v1/messages
BULKSMS_TOKEN_ID=
BULKSMS_TOKEN_SECRET=

# Payment Gateways
# PayFast
PAYFAST_MERCHANT_ID=your_merchant_id
PAYFAST_MERCHANT_KEY=your_merchant_key
PAYFAST_PASSPHRASE=your_passphrase
PAYFAST_SANDBOX=true
PAYFAST_ITN_URL=https://sms.ieosuia.com/api/payments/payfast/itn

# Ozow
OZOW_SITE_CODE=your_site_code
OZOW_PRIVATE_KEY=your_private_key
OZOW_API_KEY=your_api_key
OZOW_SANDBOX=true
OZOW_NOTIFY_URL=https://sms.ieosuia.com/api/payments/ozow/notify

# EFT Bank Details
EFT_BANK_NAME="First National Bank"
EFT_ACCOUNT_NAME="IEOSUIA PTY LTD"
EFT_ACCOUNT_NUMBER="62000000000"
EFT_BRANCH_CODE="250655"
EFT_REFERENCE_PREFIX="SMS"

# Pricing (in ZAR)
SMS_PRICE_PER_CREDIT=0.38
SMS_CREDITS_PER_MESSAGE=1
EMAIL_PRICE_PER_CREDIT=0.05

# DLR Webhook
DLR_WEBHOOK_SECRET=your_webhook_secret

# CORS
CORS_ALLOWED_ORIGINS=https://sms.ieosuia.com,http://localhost:5173

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
API_RATE_LIMIT_PER_MINUTE=120

# Logging
LOG_CHANNEL=daily
LOG_LEVEL=info
