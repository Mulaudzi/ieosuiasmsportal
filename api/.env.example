# IEOSUIA SMS Portal - Raw PHP API
APP_NAME="IEOSUIA SMS Portal"
APP_ENV=production
APP_URL=https://sms.ieosuia.com/api
FRONTEND_URL=https://sms.ieosuia.com
JWT_SECRET=your-256-bit-secret-key-here

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smsportal
DB_USERNAME=smsportal_user
DB_PASSWORD=your_secure_password

# SMS Gateway - LogicSMS
LOGICSMS_API_URL=https://www.logicsms.co.za/postmsg2.aspx
LOGICSMS_USERNAME=your_username
LOGICSMS_PASSWORD=your_password
LOGICSMS_DEFAULT_SENDER=IEOSUIA

# Mail Configuration (PHPMailer SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@ieosuia.com
MAIL_FROM_NAME="IEOSUIA SMS Portal"

# Payment - PayFast
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

# Payment - Ozow
OZOW_SITE_CODE=
OZOW_PRIVATE_KEY=
OZOW_SANDBOX=true

# Pricing
SMS_PRICE_PER_CREDIT=0.38
EMAIL_PRICE_PER_CREDIT=0.05

# DLR Webhook
DLR_WEBHOOK_SECRET=your_webhook_secret

# EFT Bank Details
EFT_BANK_NAME="First National Bank"
EFT_ACCOUNT_NAME="IEOSUIA PTY LTD"
EFT_ACCOUNT_NUMBER="62000000000"
EFT_BRANCH_CODE="250655"
