<?php
declare(strict_types=1);
const SMS_API_SETUP_EXPIRES=__EXPIRES__;
const SMS_API_SETUP_KEY_HASH='__KEY_HASH__';
const SMS_API_SETUP_MIGRATION_HASH='__MIGRATION_HASH__';
const SMS_API_SETUP_STATE='__STATE__';
const SMS_API_SETUP_CLIENT='__CLIENT__';
__SETUP_CLASS__

function smsApiSetupSnapshot(PDO $pdo):array {
    $tables=['schema_migrations','users','wallets','wallet_ledger','sms_campaigns','sms_messages','sms_daily_quota_usage','sms_login_security',...array_keys(SmsIntegrationSetup::TABLES)];
    $schema=[];
    foreach($tables as $table){
        $q=$pdo->prepare('SELECT COUNT(*) FROM information_schema.tables WHERE table_schema=DATABASE() AND table_name=?');$q->execute([$table]);
        $schema[$table]=(int)$q->fetchColumn() ? $pdo->query('SHOW CREATE TABLE `'.$table.'`')->fetch(PDO::FETCH_NUM)[1] : null;
    }
    $history=$pdo->query('SELECT version,applied_at FROM schema_migrations ORDER BY version')->fetchAll(PDO::FETCH_ASSOC);
    return ['schema'=>$schema,'migration_history'=>$history,'customer_data_exported'=>false,'schema_only_backup'=>true];
}
function smsApiSetupMain():void {
    ini_set('display_errors','0');
    header('Cache-Control: no-store, max-age=0');header('Pragma: no-cache');header('Referrer-Policy: no-referrer');header('X-Robots-Tag: noindex, nofollow, noarchive');header('X-Content-Type-Options: nosniff');
    header("Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'");
    if(!in_array(strtolower($_SERVER['HTTPS']??''),['on','1'],true)){http_response_code(400);echo 'HTTPS required';return;}
    if(time()>SMS_API_SETUP_EXPIRES){http_response_code(410);echo 'This temporary API setup link has expired.';return;}
    $method=$_SERVER['REQUEST_METHOD']??'GET';$key=$_SERVER['HTTP_X_SMS_API_SETUP_KEY']??'';
    if($method==='GET'&&$key===''&&!str_contains($_SERVER['HTTP_ACCEPT']??'','application/json')){
        header('Content-Type: text/html; charset=utf-8');$client=htmlspecialchars(SMS_API_SETUP_CLIENT,ENT_QUOTES,'UTF-8');
        echo '<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>SMS API database setup</title><script defer src="'.$client.'"></script><style>body{font:15px/1.7 system-ui;background:#f5f8fc;color:#10243f;padding:16px}main{max-width:880px;margin:20px auto;background:white;padding:25px;border:1px solid #d7e3f1;border-radius:14px}button{font:inherit;padding:10px 16px;border:1px solid #cad8eb;border-radius:7px;margin:5px;cursor:pointer}button:disabled{opacity:.5;cursor:default}#apply{background:#225ef5;color:white}label{display:flex;gap:10px;margin-block:20px}pre{white-space:pre-wrap;overflow-wrap:anywhere;background:#f1f5fa;padding:16px;border-radius:8px;font-size:12px}</style></head><body><main><h1>SMS API database setup</h1><p>Applies only migration 027_sms_integration_api. Existing wallet, account-quota and sign-in-security prerequisites must already be present. No other migration is applied automatically.</p><p><strong>Opening this link only inspects.</strong> No SMS, email, payments, customer updates, credit movements or API keys are started. This tool does not deploy or activate the API. It expires after 24 hours and permits one Apply attempt.</p><p id="status" role="status">Open the complete private link provided in our conversation.</p><label><input id="backup" type="checkbox" disabled><span>I have verified a recoverable database/schema backup for this additive migration.</span></label><button id="inspect" disabled>Inspect / refresh</button><button id="apply" disabled>Apply API setup</button><button id="copy" disabled>Copy JSON</button><pre id="output"></pre><p>After success, return the JSON so the temporary tool can be removed. If Apply is uncertain, use Inspect; never repeat Apply.</p></main></body></html>';return;
    }
    header('Content-Type: application/json; charset=utf-8');
    if(!in_array($method,['GET','POST'],true)||!hash_equals(SMS_API_SETUP_KEY_HASH,hash('sha256',$key))){http_response_code(404);echo '{"ok":false,"code":"NOT_FOUND"}';return;}
    if($method==='POST'&&($_SERVER['HTTP_ORIGIN']??'')!=='https://sms.ieosuia.com'){http_response_code(403);echo '{"ok":false,"code":"ORIGIN_DENIED"}';return;}
    $handle=null;$statePath=__DIR__.'/config/'.SMS_API_SETUP_STATE;
    try {
        global $dbConfig;require_once __DIR__.'/config/database.php';$pdo=db();
        $runner=new SmsIntegrationSetup($pdo,SMS_API_SETUP_MIGRATION_HASH);
        $mode=$_GET['mode']??'inspect';
        if($method==='GET'&&$mode==='backup'){$snapshot=smsApiSetupSnapshot($pdo);echo json_encode(['ok'=>true,'backup'=>$snapshot,'sha256'=>hash('sha256',json_encode($snapshot,JSON_THROW_ON_ERROR))],JSON_THROW_ON_ERROR);return;}
        if($method==='GET'&&$mode==='verify'){
            require_once __DIR__.'/core/QueryBuilder.php';require_once __DIR__.'/domain/SmsIntegrationService.php';
            $tables=[];foreach(array_keys(SmsIntegrationSetup::TABLES) as $table){$q=$pdo->prepare('SELECT COUNT(*) FROM information_schema.tables WHERE table_schema=DATABASE() AND table_name=?');$q->execute([$table]);$tables[$table]=(int)$q->fetchColumn()===1;}
            $q=$pdo->prepare('SELECT COUNT(*) FROM schema_migrations WHERE version=?');$q->execute([SmsIntegrationSetup::VERSION]);
            echo json_encode(['ok'=>true,'read_only'=>true,'api_enabled'=>(new SmsIntegrationService($pdo))->enabled(),'migration_recorded'=>(int)$q->fetchColumn()===1,'tables'=>$tables,'core_contract'=>defined('CampaignService::INTEGRATION_TRANSACTION_VERSION')?CampaignService::INTEGRATION_TRANSACTION_VERSION:null,'account_keys_created'=>false,'sms_submitted'=>false,'payments_processed'=>false],JSON_THROW_ON_ERROR);return;
        }
        $state=null;
        if(is_file($statePath)){
            $raw=file_get_contents($statePath);$prefix="<?php exit; ?>\n";
            if(!str_starts_with($raw,$prefix))throw new RuntimeException('Invalid receipt');
            $state=json_decode(substr($raw,strlen($prefix)),true,32,JSON_THROW_ON_ERROR);
            if(($state['phase']??'')==='completed'){echo json_encode($state['result'],JSON_THROW_ON_ERROR);return;}
            if($method==='POST')throw new RuntimeException('An attempt has started; inspect instead of retrying');
        }
        $inspection=$runner->inspect();
        if($method==='GET'){
            if($state!==null){$inspection['ready_to_apply']=false;$inspection['setup_attempted']=true;$inspection['message']='An Apply attempt started. Investigate; do not retry.';}
            echo json_encode($inspection,JSON_THROW_ON_ERROR);return;
        }
        if(!preg_match('#^application/json(?:\s*;|$)#i',$_SERVER['CONTENT_TYPE']??''))throw new RuntimeException('JSON confirmation required');
        $raw=file_get_contents('php://input',false,null,0,2049);
        if(strlen($raw)>2048)throw new RuntimeException('Request too large');
        $input=json_decode($raw,true,8,JSON_THROW_ON_ERROR);
        if(!is_array($input)||array_diff(array_keys($input),['confirm','backup_confirmed'])||($input['confirm']??null)!==SmsIntegrationSetup::VERSION||($input['backup_confirmed']??null)!==true)throw new RuntimeException('Exact migration and backup confirmation required');
        if(!$inspection['ready_to_apply']){http_response_code(409);echo json_encode($inspection,JSON_THROW_ON_ERROR);return;}
        set_time_limit(60);
        $handle=fopen($statePath,'x+b');if(!$handle||!flock($handle,LOCK_EX|LOCK_NB))throw new RuntimeException('Setup already claimed');
        $write=static function(array $value)use($handle):void{$bytes="<?php exit; ?>\n".json_encode($value,JSON_THROW_ON_ERROR);rewind($handle);if(!ftruncate($handle,0)||fwrite($handle,$bytes)!==strlen($bytes)||!fflush($handle))throw new RuntimeException('Cannot persist receipt');if(function_exists('fsync')&&!fsync($handle))throw new RuntimeException('Cannot sync receipt');};
        $write(['phase'=>'started','at_utc'=>gmdate('c')]);
        $result=$runner->apply(SmsIntegrationSetup::VERSION,true);$result['completed_at_utc']=gmdate('c');
        $write(['phase'=>'completed','result'=>$result]);echo json_encode($result,JSON_THROW_ON_ERROR);
    }catch(Throwable $e){http_response_code(503);$fingerprint=substr(hash('sha256',get_class($e).':'.$e->getMessage()),0,16);error_log('SMS API setup unavailable '.$fingerprint);echo json_encode(['ok'=>false,'code'=>'SMS_API_SETUP_UNAVAILABLE','message'=>'Setup could not be confirmed. Inspect the schema and private receipt; do not repeat Apply.','error_fingerprint'=>$fingerprint]);}
    finally{if(is_resource($handle)){flock($handle,LOCK_UN);fclose($handle);}}
}
if(!defined('SMS_API_SETUP_TEST_MODE'))smsApiSetupMain();
