<?php
declare(strict_types=1);
const RAND_SETUP_EXPIRES=__EXPIRES__;
const RAND_SETUP_KEY_HASH='__KEY_HASH__';
const RAND_SETUP_MIGRATION_HASH='__MIGRATION_HASH__';
const RAND_SETUP_CASH_HASH='__CASH_HASH__';
const RAND_SETUP_CLIENT='__CLIENT__';
const RAND_SETUP_STATE='__STATE__';

__SETUP_CLASS__

function randCreditSetupMain():void
{
    ini_set('display_errors','0');
    header('Cache-Control: no-store, max-age=0');header('Pragma: no-cache');header('X-Robots-Tag: noindex, nofollow, noarchive');header('Referrer-Policy: no-referrer');header('X-Content-Type-Options: nosniff');
    header("Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'");
    if(time()>RAND_SETUP_EXPIRES){http_response_code(410);echo 'This temporary rand-credit setup link has expired.';return;}
    $method=$_SERVER['REQUEST_METHOD']??'GET';$key=$_SERVER['HTTP_X_RAND_CREDIT_SETUP_KEY']??'';
    if($method==='GET'&&$key===''&&!str_contains($_SERVER['HTTP_ACCEPT']??'','application/json')){
        header('Content-Type: text/html; charset=utf-8');$client=htmlspecialchars(RAND_SETUP_CLIENT,ENT_QUOTES,'UTF-8');
        echo '<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Rand-credit database setup</title><script defer src="'.$client.'"></script><style>body{font:16px system-ui;background:#f5f7fb;color:#10223c;margin:0;padding:16px}main{max-width:850px;margin:20px auto;background:white;padding:24px;border:1px solid #dce4ef;border-radius:16px}button{font:inherit;padding:12px 16px;margin:6px 6px 6px 0;border:1px solid #cbd5e1;border-radius:8px;cursor:pointer}button:disabled{opacity:.5;cursor:default}#apply{background:#165af5;color:white}pre{overflow:auto;white-space:pre-wrap;word-break:break-word;font-size:13px;background:#f5f7fb;padding:16px;border-radius:8px}label{display:flex;gap:10px;margin:16px 0;align-items:flex-start}input{margin-top:5px;flex-shrink:0}[hidden]{display:none!important}</style></head><body><main><h1>Rand-credit database setup</h1><p>Sets up migration 025 for recording verified rand overpayments and deposits separately from SMS credits. Existing finance security must already be ready. Missing rand-balance prerequisite 017 may be included only with your explicit permission below. Migration 019 and all unrelated migrations are excluded.</p><p><strong>Opening this link only inspects.</strong> No balances change, SMS or emails are sent, or payments processed. The portal UI is not deployed or activated by this tool. The private link expires after 24 hours and allows one Apply attempt.</p><p id="status" role="status">Open the complete private link from our conversation.</p><label><input id="backup" type="checkbox" disabled><span>I have verified a recoverable database backup before applying this schema change.</span></label><label id="cash-row" hidden><input id="cash" type="checkbox" disabled><span>Also apply missing prerequisite 017 to create the separate rand-balance ledger and reservation tables. No opening balance or historical overpayment will be inferred.</span></label><div><button id="inspect" disabled>Inspect / refresh</button><button id="apply" disabled>Apply rand-credit setup</button><button id="copy" disabled>Copy JSON</button><button id="download" disabled>Download JSON</button></div><pre id="output"></pre><p>After success, copy the JSON back to our conversation so the temporary tool can be deleted. The feature still requires separate application deployment and activation.</p></main></body></html>';return;
    }
    header('Content-Type: application/json; charset=utf-8');
    if(!in_array($method,['GET','POST'],true)||!is_string($key)||!hash_equals(RAND_SETUP_KEY_HASH,hash('sha256',$key))){http_response_code(404);echo '{"ok":false,"code":"NOT_FOUND"}';return;}
    if($method==='POST'&&($_SERVER['HTTP_ORIGIN']??'')!=='https://sms.ieosuia.com'){http_response_code(403);echo '{"ok":false,"code":"ORIGIN_DENIED"}';return;}
    if($method==='POST'){
        try{
            if(!str_starts_with($_SERVER['CONTENT_TYPE']??'','application/json'))throw new RuntimeException('JSON confirmation required.');
            $raw=file_get_contents('php://input',false,null,0,2049);if(strlen($raw)>2048)throw new RuntimeException('Request too large.');
            $input=json_decode($raw,true,8,JSON_THROW_ON_ERROR);
            if(!is_array($input)||array_diff(array_keys($input),['confirm','backup_confirmed','include_cash_prerequisite'])||($input['confirm']??null)!=='025_cash_balance_adjustments'||($input['backup_confirmed']??null)!==true||!is_bool($input['include_cash_prerequisite']??null))throw new RuntimeException('Exact migration and backup confirmation required.');
        }catch(Throwable){http_response_code(400);echo '{"ok":false,"code":"CONFIRMATION_REQUIRED","message":"Confirm migration 025 and your verified backup. No migration was started."}';return;}
    }
    set_time_limit(60);$handle=null;$statePath=__DIR__.'/config/'.RAND_SETUP_STATE;
    try{
        if(is_file($statePath)){
            $prefix="<?php exit; ?>\n";$raw=file_get_contents($statePath);if(!str_starts_with($raw,$prefix))throw new RuntimeException('Unexpected setup receipt.');
            $state=json_decode(substr($raw,strlen($prefix)),true,32,JSON_THROW_ON_ERROR);
            if(($state['phase']??'')==='completed'){echo json_encode($state['result'],JSON_THROW_ON_ERROR);return;}
            if($method==='POST')throw new RuntimeException('An attempt has started. Inspect before any further changes.');
        }
        global $dbConfig;require_once __DIR__.'/config/database.php';
        $runner=new CashAdjustmentSetup(db(),__DIR__.'/migrations',RAND_SETUP_MIGRATION_HASH,RAND_SETUP_CASH_HASH);
        $inspection=$runner->inspect();
        if($method==='GET'){
            if(isset($state)){$inspection['ready_to_apply']=false;$inspection['setup_attempted']=true;$inspection['message']='An earlier Apply attempt started. Copy this inspection for investigation; do not apply again.';}
            echo json_encode($inspection,JSON_THROW_ON_ERROR);return;
        }
        if(!$inspection['ready_to_apply']||($inspection['cash_prerequisite_permission_required']&&!$input['include_cash_prerequisite'])){http_response_code(409);$inspection['message']='Preflight or prerequisite permission needs attention. Copy this JSON back; do not apply again.';echo json_encode($inspection,JSON_THROW_ON_ERROR);return;}
        // Consume one attempt durably before any DDL; uncertain outcomes cannot auto-retry.
        $handle=fopen($statePath,'x+b');if(!$handle||!flock($handle,LOCK_EX|LOCK_NB))throw new RuntimeException('Setup already claimed.');
        $write=static function(array $value)use($handle):void{$bytes="<?php exit; ?>\n".json_encode($value,JSON_THROW_ON_ERROR);rewind($handle);if(!ftruncate($handle,0)||fwrite($handle,$bytes)!==strlen($bytes)||!fflush($handle))throw new RuntimeException('Could not persist setup receipt.');if(function_exists('fsync')&&!fsync($handle))throw new RuntimeException('Could not sync setup receipt.');};
        $write(['phase'=>'started','at_utc'=>gmdate('c')]);
        $result=$runner->apply('025_cash_balance_adjustments',true,$input['include_cash_prerequisite']);
        $write(['phase'=>'completed','result'=>$result]);echo json_encode($result,JSON_THROW_ON_ERROR);
    }catch(Throwable $e){
        http_response_code(503);$fingerprint=substr(hash('sha256',get_class($e).':'.$e->getMessage()),0,16);error_log('Rand-credit schema unavailable fingerprint='.$fingerprint);
        echo json_encode(['ok'=>false,'code'=>'RAND_CREDIT_SETUP_UNAVAILABLE','message'=>'Setup could not be confirmed. Use Inspect / refresh and copy its JSON back. Do not repeat Apply; database DDL may have partially completed.','error_fingerprint'=>$fingerprint,'credits_moved'=>false,'sms_submitted'=>false,'emails_sent'=>false,'payments_processed'=>false]);
    }finally{if(is_resource($handle)){flock($handle,LOCK_UN);fclose($handle);}}
}
if(!defined('RAND_CREDIT_SETUP_TEST_MODE'))randCreditSetupMain();
